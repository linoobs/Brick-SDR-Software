<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="en-US" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="WelcomeDlgTitle" Value="Welcome to the [ProductName] Setup" />
  <String Id="WelcomeDlgDescription" Value="This wizard installs [ProductName] and takes about a minute. Close the program first if it runs. Settings and logs are kept, so an update keeps your configuration. A copy installed with the old .exe installer has to be removed first (Windows Settings, Apps)." />
  <String Id="ExitDialogTitle" Value="[ProductName] is installed" />
  <String Id="ExitDialogDescription" Value="The program is in the Start menu and on the desktop, and the radio is allowed through the Windows Firewall. At the first start open Setup, select the radio in the radio list and press POWER." />
</WixLocalization>
